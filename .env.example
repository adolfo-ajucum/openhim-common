# Copiar a .env y ajustar. .env NO se versiona.

# Genera una clave larga y aleatoria, p. ej.:
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
#   Linux:      openssl rand -hex 32
OPENHIM_SESSION_KEY=cambia-esto

# IP en la que se publican los puertos (0.0.0.0 = todas; o la IP LAN del equipo)
BIND_IP=0.0.0.0

# Config de la consola (default.json = localhost, default.qa.json = subdominios QA)
CONSOLE_CONFIG=./default.qa.json

OPENHIM_ROUTER_HOST=openhim-qa-router.hro.gob.gt
OPENHIM_CONSOLE_URL=https://openhim-qa.hro.gob.gt

OPENHIM_CORE_VERSION=v8.5.0
OPENHIM_CONSOLE_VERSION=v1.18.2
